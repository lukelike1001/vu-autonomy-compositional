#{ Room 1, one-node NSBT (NN1-fly). Generated by examples/room1_nn1/generate_tree.py from grid/room1_flyable.json and
   networks/room1_fly.onnx; do not edit by hand.
   Cells are (x, y), x east, y north. A proof about this model is a statement about this grid
   and these networks, not about the room or a flight. }#
configuration {
    neural
}
enumerations {
    'We', 'Ea', 'No', 'So', 'XX'
}
constants {
    W := 21, H := 20, GOAL_X := 7, GOAL_Y := 12
} end_constants

variables {
    variable { bl act VAR {'We', 'Ea', 'No', 'So', 'XX'} assign{result{'XX'}}}
    #{ the cell the tree believes it is in: copied from the environment by Act on every tick }#
    variable { bl x_cur VAR [0, (sub, W, 1)] assign{result{0}}}
    variable { bl y_cur VAR [0, (sub, H, 1)] assign{result{0}}}
    #{ flyable[y * W + x]: 1 on Room 1's flyable cells (grid/room1_flyable.json), 0 elsewhere }#
    variable { env flyable DEFINE INT static array (mult, W, H) iterative_assign, index_var
	condition {(eq, index_var, 297)} assign{result{1}}
	condition {(eq, index_var, 318)} assign{result{1}}
	condition {(eq, index_var, 339)} assign{result{1}}
	condition {(eq, index_var, 277)} assign{result{1}}
	condition {(eq, index_var, 298)} assign{result{1}}
	condition {(eq, index_var, 319)} assign{result{1}}
	condition {(eq, index_var, 340)} assign{result{1}}
	condition {(eq, index_var, 278)} assign{result{1}}
	condition {(eq, index_var, 299)} assign{result{1}}
	condition {(eq, index_var, 320)} assign{result{1}}
	condition {(eq, index_var, 341)} assign{result{1}}
	condition {(eq, index_var, 258)} assign{result{1}}
	condition {(eq, index_var, 279)} assign{result{1}}
	condition {(eq, index_var, 300)} assign{result{1}}
	condition {(eq, index_var, 321)} assign{result{1}}
	condition {(eq, index_var, 342)} assign{result{1}}
	condition {(eq, index_var, 259)} assign{result{1}}
	condition {(eq, index_var, 280)} assign{result{1}}
	condition {(eq, index_var, 301)} assign{result{1}}
	condition {(eq, index_var, 322)} assign{result{1}}
	condition {(eq, index_var, 343)} assign{result{1}}
	condition {(eq, index_var, 323)} assign{result{1}}
	assign{result{0}}
    }
    #{ the start: any flyable cell }#
    variable { env x_d VAR [0, (sub, W, 1)] assign{result{(loop, loop_var, {3, 4, 5, 6, 7, 8} such_that True, loop_var)}}}
    variable { env y_d VAR [0, (sub, H, 1)] assign{
	case {(eq, x_d, 3)} result{(loop, loop_var, {14, 15, 16} such_that True, loop_var)}
	case {(eq, x_d, 4)} result{(loop, loop_var, {13, 14, 15, 16} such_that True, loop_var)}
	case {(eq, x_d, 5)} result{(loop, loop_var, {13, 14, 15, 16} such_that True, loop_var)}
	case {(eq, x_d, 6)} result{(loop, loop_var, {12, 13, 14, 15, 16} such_that True, loop_var)}
	case {(eq, x_d, 7)} result{(loop, loop_var, {12, 13, 14, 15, 16} such_that True, loop_var)}
	case {(eq, x_d, 8)} result{(loop, loop_var, {15} such_that True, loop_var)}
	result{0}}}
    variable { bl nn1_fly NEURAL classification {'We', 'Ea', 'No', 'So', 'XX'}
	inputs {x_cur, y_cur}
	config {
	    table
	}
	source {
	    '../../networks/room1_fly.onnx'
	}
    }
} end_variables

environment_update {
    variable_statement {
	x_d
	assign {
	    case {(eq, act, 'We')} result {(max, 0, (sub, x_d, 1))}
	    case {(eq, act, 'Ea')} result {(min, (sub, W, 1), (add, x_d, 1))}
	    result {x_d}
	}
    }
    variable_statement {
	y_d
	assign {
	    case {(eq, act, 'So')} result {(max, 0, (sub, y_d, 1))}
	    case {(eq, act, 'No')} result {(min, (sub, H, 1), (add, y_d, 1))}
	    result {y_d}
	}
    }
} end_environment_update

checks {
} end_checks

environment_checks {
} end_environment_checks

actions {
    action {
	Act
	arguments {}
	local_variables {} end_local_variables
	read_variables {nn1_fly} end_read_variables
	write_variables {act, x_cur, y_cur} end_write_variables
	initial_values {} end_initial_values
	update {
	    read_environment {
		read_cell
		condition {True}
		variable_statement {
		    x_cur
		    assign {result {x_d}}
		}
		variable_statement {
		    y_cur
		    assign {result {y_d}}
		}
	    }
	    variable_statement {
		act
		assign {result {nn1_fly}}
	    }
	    return_statement {
		result {success} end_result
	    } end_return_statement
	} end_update
    } end_action
} end_actions

sub_trees {} end_sub_trees

tree {
    Act {}
} end_tree

tick_prerequisite { (True) } end_tick_prerequisite

specifications {
    #{ SAFETY: always on a flyable cell: never an obstacle, never the doorway or Room 2, and every one-cell move a
       leg the Neo 2 host's 0.60 m clearance test accepts. }#
    INVARSPEC {
	(eq, (index, flyable, (add, (mult, y_d, W), x_d)), 1)
    }
    #{ LIVENESS: from every start, eventually at (GOAL_X, GOAL_Y), the flyable cell nearest the doorway, and there
       forever. }#
    CTLSPEC {
	(always_finally, (always_globally, (and, (eq, x_d, GOAL_X), (eq, y_d, GOAL_Y))))
    }
} end_specifications
